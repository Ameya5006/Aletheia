FROM postgres:18.6-alpine3.24@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
USER root
RUN apk upgrade --no-cache && rm /usr/local/bin/gosu
LABEL org.opencontainers.image.title="Aletheia local PostgreSQL" \
      org.opencontainers.image.description="Pinned PostgreSQL with OS security updates" \
      org.opencontainers.image.version="stage3"
USER 70:70
