FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_OIDC_AUTHORITY=
ARG VITE_OIDC_CLIENT_ID=
ARG VITE_OIDC_SCOPE=openid
ARG VITE_OIDC_AUDIENCE=aletheia-api
ARG VITE_LOCAL_IDENTITY=false
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.30.2-alpine@sha256:de3e40ec8b7debd7194fc798d4bbfb102c7f8b012b2c73032816b5f72393acdd
USER root
RUN apk upgrade --no-cache
LABEL org.opencontainers.image.title="Aletheia local evidence workbench" \
      org.opencontainers.image.description="Non-root static SPA and bounded same-origin API proxy" \
      org.opencontainers.image.version="stage3"
COPY --from=build /build/dist /usr/share/nginx/html
COPY deployment/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deployment/nginx.conf /etc/nginx/nginx.conf
COPY --chmod=755 deployment/validate-proxy.sh /docker-entrypoint.d/15-aletheia-validate.sh
ENV NGINX_ENVSUBST_OUTPUT_DIR=/tmp/nginx-conf \
    NGINX_ENVSUBST_FILTER=OIDC_CONNECT_SOURCE OIDC_CONNECT_SOURCE=""
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/proxy-health
CMD ["nginx", "-g", "daemon off;", "-c", "/etc/nginx/nginx.conf"]
