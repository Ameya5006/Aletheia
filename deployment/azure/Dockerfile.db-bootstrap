FROM postgres:18.6-alpine3.24@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
USER root
COPY --chown=70:70 --chmod=0500 db-bootstrap.sh /usr/local/bin/db-bootstrap.sh
COPY --chown=70:70 --chmod=0400 mlflow-seed.dump /opt/aletheia/mlflow-seed.dump
RUN chown 70:70 /opt/aletheia && chmod 0700 /opt/aletheia
USER 70:70
ENTRYPOINT ["/usr/local/bin/db-bootstrap.sh"]
