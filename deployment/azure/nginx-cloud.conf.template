server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    access_log off;
    server_tokens off;
    client_max_body_size 4k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 12s;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${OIDC_CONNECT_SOURCE}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${OIDC_CONNECT_SOURCE}; object-src 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    location = /proxy-health { return 200 'alive'; }
    location = /.well-known/jwks.json {
        default_type application/json;
        alias /tmp/aletheia-public-jwks.json;
    }
    location /api/v1/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 12s;
        proxy_send_timeout 12s;
        proxy_next_upstream off;
    }
    location / { try_files $uri $uri/ /index.html; }
    location ~ ^/(internal|mlflow|postgres|openapi\.json) { return 404; }
}
