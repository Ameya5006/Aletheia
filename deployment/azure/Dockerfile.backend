ARG BASE_IMAGE=aletheia-azure-backend-base:07415aaf
FROM ${BASE_IMAGE}
USER root
COPY --chown=10001:10001 release/ /release/current/
COPY --chown=10001:10001 receipts/ /app/artifacts/backend-import-receipts/
USER 10001:10001
RUN python -c "from pathlib import Path; from aletheia.application.release import VerifiedRelease; VerifiedRelease(Path('/release/current'), '65f2302cc9c4795142567296cc6b16143fad5abfe4df7b04152975748c2ec271')"
CMD ["api"]
