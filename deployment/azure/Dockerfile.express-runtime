ARG RUNTIME_BASE
FROM ${RUNTIME_BASE}
USER root
RUN install -d -m 0700 -o 10001 -g 10001 /run/secrets
COPY --chown=10001:10001 --chmod=0500 cloud-entrypoint.sh /usr/local/bin/aletheia-cloud-entrypoint
# The entrypoint immediately creates /run/secrets and drops to UID 10001.
USER root
ENTRYPOINT ["/usr/local/bin/aletheia-cloud-entrypoint"]
CMD ["api"]
