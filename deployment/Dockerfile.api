ARG PYTHON_IMAGE=python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
FROM ${PYTHON_IMAGE} AS dependencies
WORKDIR /build
COPY requirements.lock.txt .
RUN python -m pip install --no-cache-dir pip==26.2.1 && \
    python -m pip wheel --only-binary=:all: --wheel-dir=/wheels -r requirements.lock.txt

FROM ${PYTHON_IMAGE} AS sqlite
# Keep the frozen CPython version; replace its ABI-compatible SQLite library.
# Upstream public-domain source, verified against sqlite.org's SHA3-256.
RUN apt-get update && apt-get install -y --no-install-recommends gcc make libc6-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN python -c "import hashlib,urllib.request; data=urllib.request.urlopen('https://www.sqlite.org/2026/sqlite-autoconf-3540000.tar.gz').read(); assert hashlib.sha3_256(data).hexdigest() == 'f5e3e724e9c9b3b5d512c76b02082091a59eeea9becd169a9fbf4d376403acce'; open('sqlite.tar.gz','wb').write(data)" && \
    tar -xzf sqlite.tar.gz && cd sqlite-autoconf-3540000 && \
    ./configure --prefix=/usr/local --disable-static --disable-readline && \
    make -j2 && make install DESTDIR=/out

FROM ${PYTHON_IMAGE} AS runtime
LABEL org.opencontainers.image.title="Aletheia local backend" \
      org.opencontainers.image.description="Synthetic-only frozen evidence serving and explicit operator jobs" \
      org.opencontainers.image.version="stage3"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 \
    MLFLOW_ENABLE_ARTIFACTS_PROGRESS_BAR=false MLFLOW_DISABLE_AGENT_HINT=1
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends libgomp1 && \
    apt-get remove -y libsqlite3-0 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 aletheia && useradd --uid 10001 --gid 10001 --no-create-home aletheia && \
    mkdir -p /app/artifacts /state /registry /release && chown -R 10001:10001 /app /state /registry /release
COPY --from=sqlite /out/usr/local/lib/libsqlite3.so* /usr/local/lib/
RUN ldconfig && python -c "import sqlite3; assert sqlite3.sqlite_version == '3.54.0'; assert sqlite3.connect(':memory:').execute('select 1').fetchone() == (1,)"
COPY --from=dependencies /wheels /wheels
COPY requirements.lock.txt /app/requirements.lock.txt
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels -r /app/requirements.lock.txt && \
    rm -rf /wheels && python -m pip check
WORKDIR /app
COPY src /app/src
COPY migrations /app/migrations
COPY alembic.ini /app/alembic.ini
COPY deployment/entrypoint.py /app/deployment/entrypoint.py
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=6 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/live', timeout=2)"
ENTRYPOINT ["python", "/app/deployment/entrypoint.py"]
CMD ["api"]
